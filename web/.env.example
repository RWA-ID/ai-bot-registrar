# Frontend env (Vite) — copy to .env.local and fill in. .env.local is gitignored.

# Etherscan API key — used to fetch recent registration logs (RecentMints)
VITE_ETHERSCAN_KEY=

# Mainnet RPC URL (e.g. Alchemy). Optional — falls back to a public RPC if unset.
VITE_ALCHEMY_RPC_URL=

# Pinata JWT — only used by scripts/upload-pinata.mjs to pin the build to IPFS
PINATA_JWT=
